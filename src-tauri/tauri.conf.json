{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Astra Cognita",
  "version": "0.1.0",
  "identifier": "com.astracognita.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Astra Cognita",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480
      },
      {
        "label": "overlay",
        "title": "Astra Cognita Overlay",
        "width": 460,
        "height": 560,
        "x": 24,
        "y": 140,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "resizable": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
